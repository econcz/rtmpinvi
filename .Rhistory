ibounds = make_bounds(lb, ub),
b_row = d$EX,
b_col = d$IM,
alpha = 1.0,
update = TRUE
)
summary(fit)
df_out[idx, ex_cols] <- fit$data
}
}
drop_cols <- grep("^_EX_.*_(lb|ub)$", names(df_out), value = TRUE)
df_out[drop_cols] <- NULL
warnings()
