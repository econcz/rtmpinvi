make_bounds <- function(lb, ub)
Map(function(a, b) c(a, b), lb, ub)
df_out <- df
for (step in 1:2) {
for (y in year) {
idx  <- df_out$year == y
d    <- df_out[idx, ]
ival <- as.matrix(d[ex_cols])
lb <- as.vector(t(as.matrix(d[paste0("_EX_", iso2, "_lb")])))
ub <- as.vector(t(as.matrix(d[paste0("_EX_", iso2, "_ub")])))
fit <- tmpinvi(
ival = ival,
ibounds = make_bounds(lb, ub),
